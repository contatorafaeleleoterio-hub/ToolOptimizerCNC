  "description": "Calculadora de parâmetros de corte CNC — núcleo de cálculo e casca offline-first.",
  "private": true,
  "type": "module",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
